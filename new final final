          <th>Status</th>
        </tr>

        <tr v-for="r in rooms" :key="r.id">
          <td>{{ r.roomNumber }}</td>
          <td>{{ r.bookingCount }}</td>
          <td>{{ r.status }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div v-if="page === 'addBooking'">
    <h2>{{ bookingId ? 'Edit Booking' : 'Add Booking' }}</h2>

    <input
      v-model="customerName"
