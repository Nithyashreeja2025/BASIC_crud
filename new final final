### `RoomController.java`

```

package com.example.own.controller;

import com.example.own.model.Room;
import com.example.own.repository.RoomRepo;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@CrossOrigin(origins = "http://localhost:5173")
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/rooms")
public class RoomController {

    private final RoomRepo repo;

    @PostMapping
    public Room addRoom(@RequestBody Room room) {
        room.setBookingCount(0);
        room.setStatus("AVAILABLE");
        return repo.save(room);
    }

    @GetMapping
    public List<Room> getRooms() {
        return repo.findAll();
    }
}

```

### `BookingController.java`

This includes add, display, edit, and delete. Editing a booking between rooms updates both rooms' counts.

```

package com.example.own.controller;

import com.example.own.model.Booking;
import com.example.own.model.Room;
import com.example.own.repository.BookingRepo;
import com.example.own.repository.RoomRepo;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@CrossOrigin(origins = "http://localhost:5173")
@RestController
@RequiredArgsConstructor
@RequestMapping("/api/bookings")
public class BookingController {

    private final BookingRepo bookingRepo;
    private final RoomRepo roomRepo;

    private void changeCount(String roomId, int change) {
        Room room = roomRepo.findById(roomId)
                .orElseThrow(() -> new RuntimeException("Room not found"));

        int count = Math.max(0, room.getBookingCount() + change);
        room.setBookingCount(count);
        room.setStatus(count > 0 ? "BOOKED" : "AVAILABLE");
        roomRepo.save(room);
    }

    @PostMapping
    public Booking addBooking(@RequestBody Booking booking) {
        roomRepo.findById(booking.getRoomId())
                .orElseThrow(() -> new RuntimeException("Room not found"));

        Booking saved = bookingRepo.save(booking);
        changeCount(saved.getRoomId(), 1);
        return saved;
    }

    @GetMapping
    public List<Booking> getBookings() {
        return bookingRepo.findAll();
    }

    @PutMapping("/{id}")
    public Booking updateBooking(@PathVariable String id,
                                 @RequestBody Booking booking) {
        Booking old = bookingRepo.findById(id)
                .orElseThrow(() -> new RuntimeException("Booking not found"));

        roomRepo.findById(booking.getRoomId())
                .orElseThrow(() -> new RuntimeException("Room not found"));

        if (!old.getRoomId().equals(booking.getRoomId())) {
            changeCount(old.getRoomId(), -1);
            changeCount(booking.getRoomId(), 1);
        }

        old.setCustomerName(booking.getCustomerName());
        old.setRoomId(booking.getRoomId());
        return bookingRepo.save(old);
    }

    @DeleteMapping("/{id}")
    public String deleteBooking(@PathVariable String id) {
        Booking booking = bookingRepo.findById(id)
                .orElseThrow(() -> new RuntimeException("Booking not found"));

        bookingRepo.deleteById(id);
        changeCount(booking.getRoomId(), -1);
        return "Booking deleted";
    }
}

```

