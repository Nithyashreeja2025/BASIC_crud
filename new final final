## 3. Vue 3 frontend

In VS Code, create a Vue project if you haven't already:

```
npm create vite@latest hotel-frontend -- --template vue
cd hotel-frontend
npm install
npm run dev
```

Replace `src/App.vue` with the following. It uses a room dropdown for bookings, so you don't need to copy room IDs manually.

```

<script setup>
import { ref, onMounted } from 'vue'

const rooms = ref([])
const bookings = ref([])
const page = ref('rooms')

const roomNumber = ref('')
const customerName = ref('')
const roomId = ref('')
const bookingId = ref('')

const roomApi = 'http://localhost:8080/api/rooms'
const bookingApi = 'http://localhost:8080/api/bookings'

async function loadData() {
  const r = await fetch(roomApi)
  const b = await fetch(bookingApi)

  if (!r.ok || !b.ok) throw new Error('Could not load data')

  rooms.value = await r.json()
  bookings.value = await b.json()
}

async function addRoom() {
  if (!roomNumber.value.trim()) {
    alert('Enter room number')
    return
  }

  const response = await fetch(roomApi, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ roomNumber: roomNumber.value })
  })

  if (!response.ok) {
    alert('Could not add room')
    return
  }

  roomNumber.value = ''
  await loadData()
}

async function saveBooking() {
  if (!customerName.value.trim() || !roomId.value) {
    alert('Enter customer name and select a room')
    return
  }

  const response = await fetch(
    bookingId.value
      ? `${bookingApi}/${bookingId.value}`
      : bookingApi,
    {
      method: bookingId.value ? 'PUT' : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        customerName: customerName.value,
        roomId: roomId.value
      })
    }
  )

  if (!response.ok) {
    alert('Booking failed')
    return
  }

  clearForm()
  await loadData()
}

function editBooking(b) {
  bookingId.value = b.id
  customerName.value = b.customerName
  roomId.value = b.roomId
  page.value = 'addBooking'
}

function clearForm() {
  bookingId.value = ''
  customerName.value = ''
  roomId.value = ''
}

async function deleteBooking(id) {
  if (!confirm('Delete this booking?')) return

  const response = await fetch(`${bookingApi}/${id}`, {
    method: 'DELETE'
  })

  if (!response.ok) {
    alert('Delete failed')
    return
  }

  await loadData()
}

onMounted(() => {
  loadData().catch(error => alert(error.message))
})
</script>

<template>
