Replace src/App.vue with this code.

This single file contains the forms and buttons for adding products, creating customers, adding products to carts, and removing products.
<script setup>
import { ref, onMounted } from 'vue'

const products = ref([])
const cart = ref([])
const customerId = ref('C101')
const customerName = ref('')

const productId = ref('')
const productName = ref('')
const price = ref(0)

const api = 'http://localhost:8080/api'

// Get all products
async function getProducts() {
  products.value = await (await fetch(api + '/products')).json()
  getCart()
}

// Add product
async function addProduct() {
  const p = {
    productId: productId.value,
    name: productName.value,
    price: price.value
  }

  await fetch(api + '/products', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(p)
  })

  productId.value = ''
  productName.value = ''
  price.value = 0

  getProducts()
}

// Create customer
async function addCustomer() {
  const c = {
    customerId: customerId.value,
    name: customerName.value,
    cart: []
  }

  const res = await fetch(api + '/customers', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(c)
  })

  alert(res.ok ? 'Customer created' : 'Error creating customer')
  getCart()
}

// Add product to cart
async function addToCart(id) {
  const res = await fetch(
    api + '/cart/' + customerId.value + '/' + id,
    { method: 'POST' }
  )

  alert(await res.text())
  getCart()
}

// Get customer's cart
async function getCart() {
  const res = await fetch(api + '/cart/' + customerId.value)

  if (res.ok) {
    const c = await res.json()
    cart.value = c ? c.cart || [] : []
  } else {
    cart.value = []
  }
}

// Remove product from cart
async function removeProduct(id) {
  const res = await fetch(
    api + '/cart/' + customerId.value + '/' + id,
    { method: 'DELETE' }
  )

  alert(await res.text())
  getCart()
}

onMounted(getProducts)
</script>

