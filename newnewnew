6. CartController.java
controller/CartController.java

This controller adds products, creates customers, adds products to carts, removes products, and displays the cart.
package com.example.cart.controller;

import com.example.cart.model.*;
import com.example.cart.repository.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import java.util.*;

@RestController
@RequestMapping("/api")
@CrossOrigin
public class CartController {

    @Autowired
    ProductRepository productRepo;

    @Autowired
    CustomerRepository customerRepo;

    // Add product
    @PostMapping("/products")
    public Product addProduct(@RequestBody Product p) {
        return productRepo.save(p);
    }

    // Display all products
    @GetMapping("/products")
    public List<Product> getProducts() {
        return productRepo.findAll();
    }

    // Create customer
    @PostMapping("/customers")
    public Customer addCustomer(@RequestBody Customer c) {
        c.setCart(new ArrayList<>());
        return customerRepo.save(c);
    }

    // Add product to cart using IDs
    @PostMapping("/cart/{customerId}/{productId}")
    public String addToCart(
            @PathVariable String customerId,
            @PathVariable String productId) {

        Customer c = customerRepo.findById(customerId).orElse(null);
        Product p = productRepo.findById(productId).orElse(null);

        if (c == null)
            return "Customer not found";

        if (p == null)
            return "Product not found";

        if (c.getCart().contains(productId))
            return "Product already in cart";

        c.getCart().add(productId);
        customerRepo.save(c);

        return "Product added to cart";
    }

    // Remove product from cart
    @DeleteMapping("/cart/{customerId}/{productId}")
    public String removeFromCart(
            @PathVariable String customerId,
            @PathVariable String productId) {

        Customer c = customerRepo.findById(customerId).orElse(null);

        if (c == null)
            return "Customer not found";

        if (!c.getCart().remove(productId))
            return "Product not in cart";

        customerRepo.save(c);

        return "Product removed from cart";
    }

    // Display customer's cart IDs
    @GetMapping("/cart/{customerId}")
    public Customer getCart(@PathVariable String customerId) {
        return customerRepo.findById(customerId).orElse(null);
    }
}

